# 复制本文件为 .env 后再填写本机配置。
# 本文件只能保留示例值；不要写入真实 API Key、密码或生产地址。

# ============== 应用基础 ==============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ============== JWT ==============
JWT_SECRET_KEY=replace-with-a-long-random-secret

# ============== 大模型 ==============
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
QWEN_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=8000

# ============== LangSmith（不用时保持关闭） ==============
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_PROJECT=travel-planner-dev
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============== PostgreSQL ==============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_agent
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=replace-with-postgres-password

# ============== Redis ==============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============== 地图、搜索和外部 MCP 服务 ==============
AMAP_API_KEY=replace-with-amap-api-key
AMAP_QPS=3.0
TAVILY_API_KEY=replace-with-tavily-api-key
QQ_MAP_KEY=replace-with-qq-map-key
VARIFLIGHT_API_KEY=replace-with-variflight-api-key
AIGOHOTEL_MCP_API=replace-with-aigohotel-api-key

# 浏览器访问后端的公开地址；前后端同域或由前端代理 /api 时可留空
PUBLIC_BASE_URL=http://localhost:8000

# ============== 流式渲染 ==============
# 前端自行做打字效果时可把 RENDER_CHARS_PER_SECOND 设为 0
RENDER_CHARS_PER_SECOND=80.0
RENDER_MAX_SECONDS=20.0

# ============== DeepSeek（不用时可留空） ==============
DEEP_SEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# ============== 评测 ==============
DEEPEVAL_TELEMETRY_OPT_OUT=YES
